          "name": "Get trading conditions for a contract option.",
          "request": {
            "name": "Get trading conditions for a contract option.",
            "description": {
              "content": "Trading conditions for all exchange traded options and synthetic options(OTC). \n             Trading conditions details default behavior for the option (can it be traded and how), \n             margin requirements for opening and holding a position in an option (how much cash is needed on the account) \n             as well as the cost structure of opening, closing and holding a position.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "cs",
                "v1",
                "tradingconditions",
                "ContractOptionSpaces",
                ":AccountKey",
                ":OptionRootId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [

{
  "item": [
    {
      "id": "ef54f869-e28e-41a6-81a1-08b469220942",
      "name": "Standing Instructions",
      "description": {
        "content": "A Standing instruction is a rule that defines how an election should be applied automatically.\r\n            Standing instructions only applicable to event types Dividend Reinvestment (DRIP) and \r\n            Dividend Option (DVOP) and option types Cash or Securities.\r\n            A standing instruction specifies that whenever voluntary event of type DRIP or DVOP occurs, \r\n            an election should be made automatically for either Cash or Securities option for account(s) \r\n            and instrument(s) specified in the instruction.",
        "type": "text/plain"
      },
      "item": [

            "params": [
              {
                "name": "ContextId",
                "value": "29931122",
                "type": "path",
                "description": "Unique streaming context ID part of the streaming session."
              },
              {
                "name": "Tag",
                "value": "TAB15",
                "type": "query",
                "description": "Tag that subscriptions are marked with"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",

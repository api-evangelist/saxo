        {
          "info": {
            "name": "Create client",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://gateway.saxobank.com/sim/openapi/cm/v1/signups",
            "params": [
              {
                "name": "OwnerKey",
                "value": "d2-PzdC5wIPy1284wD-rRA==",
                "type": "query",
                "description": "Client key of owner, under which this signup will be created. If not provided, signup will be created under the LoggedIn client"

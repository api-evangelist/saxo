        {
          "info": {
            "name": "Completes the onboarding application",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://gateway.saxobank.com/sim/openapi/cm/v1/signups/completeapplication/:SignUpId",
            "params": [
              {
                "name": "AwaitAccountCreation",
                "value": "true",
                "type": "query",
                "description": "Flag to mention if you want to wait for account creation. Set it to true to wait for account details or false if you don't want the account details immediately."
              },
              {
                "name": "SignUpId",
                "value": "5b68ce05-24f7-491c-a3aa-6a43f7923cee",

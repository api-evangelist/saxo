          "id": "208e712a-f0cb-4fc5-ba86-4644592e1177",
          "name": "Get Account statement report for the accounts of a Specified client",
          "request": {
            "name": "Get Account statement report for the accounts of a Specified client",
            "description": {
              "content": "Get an account statement report for the accounts of a Specified client.\r\n            \r\nThis report is available in the following formats:\r\n\r\n\r\n*   PDF\r\n*   Excel\r\n\r\nTo request a specific format, please set the 'Accept' header on your request to one of the following:\r\n\r\n\r\n*   For PDF : application/pdf\r\n*   For Excel : application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "cr",
                "v1",
                "reports",
                "AccountStatement",
                ":ClientKey"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "AccountGroupKey",
                  "value": "<string>",
                  "description": "The account group id."
                },
                {
                  "disabled": false,
                  "key": "AccountKey",
                  "value": "<string>",
                  "description": "The account key."
                },
                {
                  "disabled": false,
                  "key": "FromDate",
                  "value": "<date>",
                  "description": "Include Account statement from this date. By default returns the previous date report."
                },
                {
                  "disabled": false,
                  "key": "ToDate",
                  "value": "<date>",
                  "description": "Include Account statement till this date. By default returns the previous date report."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "ClientKey",
                  "description": "(Required) Unique id of the client."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "accessTokenUrl",
                  "value": "https://sim.logonvalidation.net/token"
                },
                {
                  "key": "authUrl",
                  "value": "https://sim.logonvalidation.net/authorize"
                },
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                }
              ]
            }
          },
